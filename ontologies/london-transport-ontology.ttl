###############################################################################
#  ONTOLOGY:  London Public Transportation Knowledge Graph
#  MODULE:    5CCSAKNE Coursework 2 - Modelling Expert Deliverable
#  DOMAIN:    London Public Transport - all modes covered by Oyster (Zones 1-6)
#  VERSION:   3.0  |  DATE: 2026-03-25
#
#  SCOPE: TfL modes accepted by Oyster card in Zones 1-6:
#    London Underground, London Bus, DLR, London Overground,
#    Elizabeth line, London Trams (Tramlink), Emirates Air Line
#
#  EXTERNAL ONTOLOGIES EXTENDED (satisfies 2 x subclass + 2 x subproperty):
#    Schema.org (https://schema.org/) and DBpedia Ontology (https://dbpedia.org/ontology/)
#
#  NOTE: TBox only. All individuals (ABox) will be auto-populated
#        by the Python data-ingestion pipeline via the TfL Unified API.
###############################################################################

@prefix :       <http://kcl.ac.uk/ontology/london-transport#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dcterms:<http://purl.org/dc/terms/> .

#################################################################
#  ONTOLOGY HEADER
#################################################################

<http://kcl.ac.uk/ontology/london-transport>
    rdf:type owl:Ontology ;
    rdfs:label "London Public Transportation Ontology"@en ;
    rdfs:comment "OWL 2 ontology for the TfL network within Oyster Zones 1-6. TBox only."@en ;
    dcterms:creator "KCL 5CCSAKNE CW2 - Modelling Expert" ;
    dcterms:created "2026-03-25"^^xsd:date ;
    owl:versionInfo "3.0" .

#################################################################
#  SECTION 1 - EXTERNAL ONTOLOGY EXTENSIONS
#  Requirement: >=2 subclasses and >=2 subproperties from >=2 ontologies
#################################################################

# Extending Schema.org -------------------------------------------------------

# SUBCLASS 1 of 4 (Schema.org): schema:CivicStructure -> :TransitStop
:TransitStop rdf:type owl:Class ;
    rdfs:subClassOf schema:CivicStructure ;
    rdfs:label "Transit Stop"@en ;
    rdfs:comment "Any physical boarding/alighting location in the TfL network (station, bus stop, tram stop, cable car pier). Subclass of schema:CivicStructure."@en .

# SUBCLASS 2 of 4 (Schema.org): schema:PriceSpecification -> :OysterFare
:OysterFare rdf:type owl:Class ;
    rdfs:subClassOf schema:PriceSpecification ;
    rdfs:label "Oyster Fare"@en ;
    rdfs:comment "A fare charged for an Oyster/contactless journey, structured by zone band and peak/off-peak. Subclass of schema:PriceSpecification."@en .

# SUBPROPERTY 1 of 4 (Schema.org): schema:geo -> :hasCoordinates
:hasCoordinates rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf schema:geo ;
    rdfs:domain :TransitStop ;
    rdfs:range :GeoPoint ;
    rdfs:label "has coordinates"@en ;
    rdfs:comment "Links a stop to its WGS84 geographic location. Subproperty of schema:geo."@en .

# SUBPROPERTY 2 of 4 (Schema.org): schema:amenityFeature -> :hasAccessibilityFeature
:hasAccessibilityFeature rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf schema:amenityFeature ;
    rdfs:domain :TransitStop ;
    rdfs:range :AccessibilityFeature ;
    rdfs:label "has accessibility feature"@en ;
    rdfs:comment "Links a stop to an accessibility provision it offers. Subproperty of schema:amenityFeature."@en .

# Extending DBpedia Ontology -------------------------------------------------

# SUBCLASS 3 of 4 (DBpedia): dbo:RouteOfTransportation -> :TfLLine
:TfLLine rdf:type owl:Class ;
    rdfs:subClassOf dbo:RouteOfTransportation ;
    rdfs:label "TfL Line"@en ;
    rdfs:comment "A public transport route managed or franchised by TfL and payable by Oyster. Subclass of dbo:RouteOfTransportation."@en .

# SUBCLASS 4 of 4 (DBpedia): dbo:Organisation -> :TransportOperator
:TransportOperator rdf:type owl:Class ;
    rdfs:subClassOf dbo:Organisation ;
    rdfs:label "Transport Operator"@en ;
    rdfs:comment "A company that runs TfL services under direct management or franchise. Subclass of dbo:Organisation."@en .

# SUBPROPERTY 3 of 4 (DBpedia): dbo:operator -> :operatedBy
:operatedBy rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf dbo:operator ;
    rdfs:domain :TfLLine ;
    rdfs:range :TransportOperator ;
    rdfs:label "operated by"@en ;
    rdfs:comment "Links a TfL line to the operator responsible for running it. Subproperty of dbo:operator."@en .

# SUBPROPERTY 4 of 4 (DBpedia): dbo:abstract -> :disruptionDetail
:disruptionDetail rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf dbo:abstract ;
    rdfs:domain :ServiceDisruption ;
    rdfs:range xsd:string ;
    rdfs:label "disruption detail"@en ;
    rdfs:comment "Free-text cause/impact of a disruption, extracted from TfL API or news via NLP. Subproperty of dbo:abstract."@en .

#################################################################
#  SECTION 2 - TRANSPORT MODES
#  One class per Oyster-accepted mode in Zones 1-6
#################################################################

:TransportMode rdf:type owl:Class ;
    rdfs:label "Transport Mode"@en ;
    rdfs:comment "The physical modality of a TfL service."@en .

:UndergroundMode rdf:type owl:Class ;
    rdfs:subClassOf :TransportMode ;
    rdfs:label "Underground"@en ;
    rdfs:comment "London Underground (Tube) - deep-level and sub-surface lines."@en .

:BusMode rdf:type owl:Class ;
    rdfs:subClassOf :TransportMode ;
    rdfs:label "Bus"@en ;
    rdfs:comment "London Bus network, day and night routes. Flat Oyster fare."@en .

:DLRMode rdf:type owl:Class ;
    rdfs:subClassOf :TransportMode ;
    rdfs:label "DLR"@en ;
    rdfs:comment "Docklands Light Railway - automated light rail in east London."@en .

:OvergroundMode rdf:type owl:Class ;
    rdfs:subClassOf :TransportMode ;
    rdfs:label "Overground"@en ;
    rdfs:comment "London Overground surface rail network, Zones 1-6."@en .

:ElizabethLineMode rdf:type owl:Class ;
    rdfs:subClassOf :TransportMode ;
    rdfs:label "Elizabeth Line"@en ;
    rdfs:comment "Elizabeth line (Crossrail) high-capacity rail, Zones 1-6 and beyond."@en .

:TramMode rdf:type owl:Class ;
    rdfs:subClassOf :TransportMode ;
    rdfs:label "Tram"@en ;
    rdfs:comment "London Tramlink tram network in south London (Zones 3-5). Flat Oyster fare."@en .

:EmiratesAirLineMode rdf:type owl:Class ;
    rdfs:subClassOf :TransportMode ;
    rdfs:label "Emirates Air Line"@en ;
    rdfs:comment "Cable car across the Thames (Zones 2-3). Oyster accepted at a flat fare."@en .

#################################################################
#  SECTION 3 - TRANSIT LINES
#  Subclasses of :TfLLine, one hierarchy per Oyster-covered mode
#################################################################

:TubeLine rdf:type owl:Class ;
    rdfs:subClassOf :TfLLine ;
    rdfs:label "Tube Line"@en ;
    rdfs:comment "One of the 11 named London Underground lines, each with a TfL brand colour."@en .

:NightTubeLine rdf:type owl:Class ;
    rdfs:subClassOf :TubeLine ;
    rdfs:label "Night Tube Line"@en ;
    rdfs:comment "A Tube line with overnight Friday/Saturday service (Central, Victoria, Jubilee, Northern, Piccadilly)."@en .

:BusRoute rdf:type owl:Class ;
    rdfs:subClassOf :TfLLine ;
    rdfs:label "Bus Route"@en ;
    rdfs:comment "A numbered or lettered TfL bus route."@en .

:NightBusRoute rdf:type owl:Class ;
    rdfs:subClassOf :BusRoute ;
    rdfs:label "Night Bus Route"@en ;
    rdfs:comment "A bus route operating primarily at night, identified by an N-prefix (e.g. N25)."@en .

:DLRLine rdf:type owl:Class ;
    rdfs:subClassOf :TfLLine ;
    rdfs:label "DLR Line"@en ;
    rdfs:comment "A branch of the Docklands Light Railway network."@en .

:OvergroundLine rdf:type owl:Class ;
    rdfs:subClassOf :TfLLine ;
    rdfs:label "Overground Line"@en ;
    rdfs:comment "One of the six named Overground routes (Lioness, Mildmay, Windrush, Weaver, Suffragette, Liberty)."@en .

:ElizabethLine rdf:type owl:Class ;
    rdfs:subClassOf :TfLLine ;
    rdfs:label "Elizabeth Line"@en ;
    rdfs:comment "The Elizabeth line (Crossrail) corridor across London."@en .

:TramRoute rdf:type owl:Class ;
    rdfs:subClassOf :TfLLine ;
    rdfs:label "Tram Route"@en ;
    rdfs:comment "A numbered Tramlink route in south London."@en .

:EmiratesAirLineRoute rdf:type owl:Class ;
    rdfs:subClassOf :TfLLine ;
    rdfs:label "Emirates Air Line Route"@en ;
    rdfs:comment "The single cable-car crossing route on the Emirates Air Line."@en .

#################################################################
#  SECTION 4 - TRANSIT STOPS
#  Subclasses of :TransitStop, one per mode type
#################################################################

:TubeStation rdf:type owl:Class ;
    rdfs:subClassOf :TransitStop ;
    rdfs:label "Tube Station"@en ;
    rdfs:comment "A station on one or more London Underground lines."@en .

:BusStop rdf:type owl:Class ;
    rdfs:subClassOf :TransitStop ;
    rdfs:label "Bus Stop"@en ;
    rdfs:comment "A designated boarding/alighting point for bus services."@en .

:BusTerminus rdf:type owl:Class ;
    rdfs:subClassOf :BusStop ;
    rdfs:label "Bus Terminus"@en ;
    rdfs:comment "The start or end terminal stop of a bus route."@en .

:DLRStation rdf:type owl:Class ;
    rdfs:subClassOf :TransitStop ;
    rdfs:label "DLR Station"@en ;
    rdfs:comment "A station on the Docklands Light Railway network."@en .

:OvergroundStation rdf:type owl:Class ;
    rdfs:subClassOf :TransitStop ;
    rdfs:label "Overground Station"@en ;
    rdfs:comment "A station on the London Overground network."@en .

:ElizabethLineStation rdf:type owl:Class ;
    rdfs:subClassOf :TransitStop ;
    rdfs:label "Elizabeth Line Station"@en ;
    rdfs:comment "A station on the Elizabeth line corridor."@en .

:TramStop rdf:type owl:Class ;
    rdfs:subClassOf :TransitStop ;
    rdfs:label "Tram Stop"@en ;
    rdfs:comment "A stop on the London Tramlink network."@en .

:InterchangeStation rdf:type owl:Class ;
    rdfs:subClassOf :TransitStop ;
    rdfs:label "Interchange Station"@en ;
    rdfs:comment "A station where passengers can change between two or more lines or modes."@en .

:CableCarPier rdf:type owl:Class ;
    rdfs:subClassOf :TransitStop ;
    rdfs:label "Cable Car Pier"@en ;
    rdfs:comment "A boarding pier for the Emirates Air Line cable car."@en .

#################################################################
#  SECTION 5 - FARE ZONES  (Zones 1-6, Oyster scope)
#################################################################

:FareZone rdf:type owl:Class ;
    rdfs:label "Fare Zone"@en ;
    rdfs:comment "One of the concentric Oyster fare zones 1-6. Zones 7-9 are outside standard Oyster scope."@en .

#################################################################
#  SECTION 6 - SERVICE STATUS
#################################################################

:ServiceStatus rdf:type owl:Class ;
    rdfs:label "Service Status"@en ;
    rdfs:comment "The operational condition of a TfL line at a given time, from the TfL API /line/{id}/status endpoint."@en .

:GoodService rdf:type owl:Class ;
    rdfs:subClassOf :ServiceStatus ;
    rdfs:label "Good Service"@en ;
    rdfs:comment "Normal operations with no reported issues."@en .

:ServiceDisruption rdf:type owl:Class ;
    rdfs:subClassOf :ServiceStatus ;
    rdfs:label "Service Disruption"@en ;
    rdfs:comment "A degraded or suspended service condition (Minor Delays, Severe Delays, Part Suspension, Suspended)."@en .

:PlannedClosure rdf:type owl:Class ;
    rdfs:subClassOf :ServiceDisruption ;
    rdfs:label "Planned Closure"@en ;
    rdfs:comment "A pre-announced engineering closure, typically overnight or at weekends."@en .

:UnplannedDisruption rdf:type owl:Class ;
    rdfs:subClassOf :ServiceDisruption ;
    rdfs:label "Unplanned Disruption"@en ;
    rdfs:comment "A sudden reactive incident such as a signal failure or passenger incident."@en .

#################################################################
#  SECTION 7 - ACCESSIBILITY
#################################################################

:AccessibilityFeature rdf:type owl:Class ;
    rdfs:label "Accessibility Feature"@en ;
    rdfs:comment "A feature assisting passengers with mobility or sensory needs, per the TfL GAPS programme."@en .

:StepFreeAccess rdf:type owl:Class ;
    rdfs:subClassOf :AccessibilityFeature ;
    rdfs:label "Step-Free Access"@en ;
    rdfs:comment "Lift or ramp enabling level access from street to platform or train."@en .

:AudioVisualAid rdf:type owl:Class ;
    rdfs:subClassOf :AccessibilityFeature ;
    rdfs:label "Audio-Visual Aid"@en ;
    rdfs:comment "Announcements, displays or induction loops for sensory-impaired passengers."@en .

:AssistanceService rdf:type owl:Class ;
    rdfs:subClassOf :AccessibilityFeature ;
    rdfs:label "Assistance Service"@en ;
    rdfs:comment "Staff-assisted boarding or the Passenger Assist request scheme."@en .

#################################################################
#  SECTION 8 - SUPPORTING CLASSES
#################################################################

:GeoPoint rdf:type owl:Class ;
    rdfs:label "Geographic Point"@en ;
    rdfs:comment "A WGS84 latitude/longitude coordinate pair for a stop or station."@en .

:Journey rdf:type owl:Class ;
    rdfs:label "Journey"@en ;
    rdfs:comment "An end-to-end passenger trip from origin to destination, possibly spanning multiple legs and modes."@en .

:JourneyLeg rdf:type owl:Class ;
    rdfs:label "Journey Leg"@en ;
    rdfs:comment "A single unbroken segment of a journey on one line between two stops."@en .

:PassengerCategory rdf:type owl:Class ;
    rdfs:label "Passenger Category"@en ;
    rdfs:comment "A traveller category with distinct Oyster entitlements (e.g. Adult, Child, Disabled, 60+ Oyster)."@en .

:Timetable rdf:type owl:Class ;
    rdfs:label "Timetable"@en ;
    rdfs:comment "Scheduled service times for a line, varying by day type (weekday, Saturday, Sunday)."@en .

#################################################################
#  SECTION 9 - OBJECT PROPERTIES
#################################################################

# Line relations

:hasStop rdf:type owl:ObjectProperty ;
    rdfs:domain :TfLLine ;
    rdfs:range :TransitStop ;
    rdfs:label "has stop"@en ;
    rdfs:comment "Links a line to a stop or station it serves."@en .

:isServedBy rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasStop ;
    rdfs:domain :TransitStop ;
    rdfs:range :TfLLine ;
    rdfs:label "is served by"@en ;
    rdfs:comment "Inverse of :hasStop. Links a stop to the lines that call there."@en .

:hasTerminus rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasStop ;
    rdfs:domain :TfLLine ;
    rdfs:range :TransitStop ;
    rdfs:label "has terminus"@en ;
    rdfs:comment "Links a line to an end-of-line terminus stop. Subproperty of :hasStop."@en .

:servesMode rdf:type owl:ObjectProperty ;
    rdfs:domain :TfLLine ;
    rdfs:range :TransportMode ;
    rdfs:label "serves mode"@en ;
    rdfs:comment "Links a line to the transport mode it belongs to."@en .

:hasStatus rdf:type owl:ObjectProperty ;
    rdfs:domain :TfLLine ;
    rdfs:range :ServiceStatus ;
    rdfs:label "has status"@en ;
    rdfs:comment "Links a line to its current service status from the TfL API."@en .

:hasTimetable rdf:type owl:ObjectProperty ;
    rdfs:domain :TfLLine ;
    rdfs:range :Timetable ;
    rdfs:label "has timetable"@en ;
    rdfs:comment "Links a line to its scheduled timetable."@en .

# Stop relations

:inFareZone rdf:type owl:ObjectProperty ;
    rdfs:domain :TransitStop ;
    rdfs:range :FareZone ;
    rdfs:label "in fare zone"@en ;
    rdfs:comment "Links a stop to its Oyster fare zone(s). A boundary stop may link to two zones."@en .

:connectsTo rdf:type owl:ObjectProperty ;
    rdf:type owl:SymmetricProperty ;
    rdfs:domain :TransitStop ;
    rdfs:range :TransitStop ;
    rdfs:label "connects to"@en ;
    rdfs:comment "Symmetric property indicating a direct interchange between two stops."@en .

# Disruption relations

:affectsLine rdf:type owl:ObjectProperty ;
    owl:inverseOf :hasStatus ;
    rdfs:domain :ServiceDisruption ;
    rdfs:range :TfLLine ;
    rdfs:label "affects line"@en ;
    rdfs:comment "Links a disruption to all TfL lines it impacts."@en .

:hasAlternativeService rdf:type owl:ObjectProperty ;
    rdfs:domain :ServiceDisruption ;
    rdfs:range :TfLLine ;
    rdfs:label "has alternative service"@en ;
    rdfs:comment "Links a disruption to a replacement line recommended to passengers."@en .

# Journey relations

:hasOrigin rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :Journey ;
    rdfs:range :TransitStop ;
    rdfs:label "has origin"@en ;
    rdfs:comment "Links a journey to its single origin stop. Functional property."@en .

:hasDestination rdf:type owl:ObjectProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :Journey ;
    rdfs:range :TransitStop ;
    rdfs:label "has destination"@en ;
    rdfs:comment "Links a journey to its single destination stop. Functional property."@en .

:hasLeg rdf:type owl:ObjectProperty ;
    rdfs:domain :Journey ;
    rdfs:range :JourneyLeg ;
    rdfs:label "has leg"@en ;
    rdfs:comment "Links a journey to its constituent legs."@en .

:usesLine rdf:type owl:ObjectProperty ;
    rdfs:domain :JourneyLeg ;
    rdfs:range :TfLLine ;
    rdfs:label "uses line"@en ;
    rdfs:comment "Links a journey leg to the TfL line taken for that segment."@en .

:boardsAt rdf:type owl:ObjectProperty ;
    rdfs:domain :JourneyLeg ;
    rdfs:range :TransitStop ;
    rdfs:label "boards at"@en ;
    rdfs:comment "Links a journey leg to the stop where the passenger boards."@en .

:alightsAt rdf:type owl:ObjectProperty ;
    rdfs:domain :JourneyLeg ;
    rdfs:range :TransitStop ;
    rdfs:label "alights at"@en ;
    rdfs:comment "Links a journey leg to the stop where the passenger alights."@en .

:requiresFare rdf:type owl:ObjectProperty ;
    rdfs:domain :Journey ;
    rdfs:range :OysterFare ;
    rdfs:label "requires fare"@en ;
    rdfs:comment "Links a journey to the Oyster fare applicable to it."@en .

:applicableTo rdf:type owl:ObjectProperty ;
    rdfs:domain :OysterFare ;
    rdfs:range :PassengerCategory ;
    rdfs:label "applicable to"@en ;
    rdfs:comment "Links a fare to the passenger category it applies to (e.g. Adult, Child)."@en .

#################################################################
#  SECTION 10 - DATA PROPERTIES
#################################################################

# Line attributes

:lineId rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :TfLLine ;
    rdfs:range xsd:string ;
    rdfs:label "line ID"@en ;
    rdfs:comment "TfL Unified API identifier for the line (e.g. 'victoria', '25', 'elizabeth')."@en .

:lineName rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :TfLLine ;
    rdfs:range xsd:string ;
    rdfs:label "line name"@en ;
    rdfs:comment "Official human-readable name of the line (e.g. 'Victoria line')."@en .

:lineColour rdf:type owl:DatatypeProperty ;
    rdfs:domain :TubeLine ;
    rdfs:range xsd:string ;
    rdfs:label "line colour (hex)"@en ;
    rdfs:comment "Official TfL brand colour in hex RGB (e.g. '#0098D4' for Victoria line)."@en .

:isNightService rdf:type owl:DatatypeProperty ;
    rdfs:domain :TfLLine ;
    rdfs:range xsd:boolean ;
    rdfs:label "is night service"@en ;
    rdfs:comment "True if the line or route operates an overnight service."@en .

:routeNumber rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :BusRoute ;
    rdfs:range xsd:string ;
    rdfs:label "route number"@en ;
    rdfs:comment "Numeric or alphanumeric identifier shown on vehicles and stops (e.g. '25', 'N55')."@en .

# Stop attributes

:stopName rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :TransitStop ;
    rdfs:range xsd:string ;
    rdfs:label "stop name"@en ;
    rdfs:comment "Official TfL name of the stop or station."@en .

:naptanId rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :TransitStop ;
    rdfs:range xsd:string ;
    rdfs:label "NaPTAN ID"@en ;
    rdfs:comment "National Public Transport Access Node unique identifier used by the TfL API."@en .

:fareZoneNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain :TransitStop ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "fare zone number"@en ;
    rdfs:comment "Primary Oyster fare zone (1-6) of the stop."@en .

:isStepFree rdf:type owl:DatatypeProperty ;
    rdfs:domain :TransitStop ;
    rdfs:range xsd:boolean ;
    rdfs:label "is step-free"@en ;
    rdfs:comment "True if the stop has any level of step-free access from street to platform or train."@en .

:hasWifi rdf:type owl:DatatypeProperty ;
    rdfs:domain :TransitStop ;
    rdfs:range xsd:boolean ;
    rdfs:label "has WiFi"@en ;
    rdfs:comment "True if free TfL WiFi is available at the stop."@en .

:stopSmsCode rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :BusStop ;
    rdfs:range xsd:string ;
    rdfs:label "SMS code"@en ;
    rdfs:comment "5-digit SMS code at a bus stop for live arrival information."@en .

# Geographic point attributes

:latitude rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :GeoPoint ;
    rdfs:range xsd:decimal ;
    rdfs:label "latitude"@en ;
    rdfs:comment "WGS84 decimal latitude."@en .

:longitude rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :GeoPoint ;
    rdfs:range xsd:decimal ;
    rdfs:label "longitude"@en ;
    rdfs:comment "WGS84 decimal longitude."@en .

# Fare zone attributes

:zoneNumber rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :FareZone ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "zone number"@en ;
    rdfs:comment "Numeric identifier of the Oyster fare zone (1-6)."@en .

# Service status attributes

:statusSeverity rdf:type owl:DatatypeProperty ;
    rdfs:domain :ServiceStatus ;
    rdfs:range xsd:integer ;
    rdfs:label "status severity"@en ;
    rdfs:comment "TfL API severity code (10=Good, 5=Severe Delays, 0=Suspended). Lower means worse."@en .

:statusDescription rdf:type owl:DatatypeProperty ;
    rdfs:domain :ServiceStatus ;
    rdfs:range xsd:string ;
    rdfs:label "status description"@en ;
    rdfs:comment "Free-text status message from the TfL API or extracted from news."@en .

:disruptionStart rdf:type owl:DatatypeProperty ;
    rdfs:domain :ServiceDisruption ;
    rdfs:range xsd:dateTime ;
    rdfs:label "disruption start"@en ;
    rdfs:comment "DateTime when the disruption began or is scheduled to begin."@en .

:disruptionEnd rdf:type owl:DatatypeProperty ;
    rdfs:domain :ServiceDisruption ;
    rdfs:range xsd:dateTime ;
    rdfs:label "disruption end"@en ;
    rdfs:comment "Expected or actual DateTime when the disruption ends."@en .

:isPlanned rdf:type owl:DatatypeProperty ;
    rdfs:domain :ServiceDisruption ;
    rdfs:range xsd:boolean ;
    rdfs:label "is planned"@en ;
    rdfs:comment "True if the disruption was pre-announced (e.g. weekend engineering works)."@en .

# Fare attributes

:fareAmount rdf:type owl:DatatypeProperty ;
    rdf:type owl:FunctionalProperty ;
    rdfs:domain :OysterFare ;
    rdfs:range xsd:decimal ;
    rdfs:label "fare amount (GBP)"@en ;
    rdfs:comment "Oyster/contactless fare in GBP (e.g. 2.80)."@en .

:farePeakType rdf:type owl:DatatypeProperty ;
    rdfs:domain :OysterFare ;
    rdfs:range xsd:string ;
    rdfs:label "peak type"@en ;
    rdfs:comment "Whether the fare applies at 'peak', 'off-peak', or 'anytime'."@en .

:fareZoneBand rdf:type owl:DatatypeProperty ;
    rdfs:domain :OysterFare ;
    rdfs:range xsd:string ;
    rdfs:label "zone band"@en ;
