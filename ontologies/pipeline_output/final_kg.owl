  <rdf:Description rdf:about="http://vocab.gtfs.org/terms#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">General Transit Feed Specification</rdfs:label>
    <rdfs:label xml:lang="es">Especificación General de Feeds de Transporte Público</rdfs:label>
    <dcterms:creator rdf:nodeID="ndfdf04acf8b4444695d6394457911d6ab1"/>
    <dcterms:creator rdf:nodeID="ndfdf04acf8b4444695d6394457911d6ab2"/>
    <dcterms:description xml:lang="en">This ontology is a translation of the General Transit Feed Specification towards URIs. Its intended use is creating an exchange platform where the Linked GTFS model can be used as a start to get the right data into the right format. For semantics of the classes and properties, see https://developers.google.com/transit/gtfs/reference.</dcterms:description>
    <dcterms:description xml:lang="es">Esta ontología es una traducción de la Especificación General de Feeds de Transporte Público a URIs. El objetivo es crear una plataforma de intercambio donde el modelo Linked GTFS pueda usarse para obtener los datos correctos en el formato adecuado. Para la especificación semántica de clases y propiedades, visite https://developers.google.com/transit/gtfs/reference.</dcterms:description>
    <vann:preferredNamespacePrefix>gtfs</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://vocab.gtfs.org/terms#</vann:preferredNamespaceUri>
    <rdfs:seeAlso rdf:resource="https://developers.google.com/transit/gtfs/reference"/>
  </rdf:Description>
