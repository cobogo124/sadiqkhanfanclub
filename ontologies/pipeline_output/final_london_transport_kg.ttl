    rdfs:label "Color"@en,
        "color"@es ;
    rdfs:comment "A 6 character hexidecimal color (without #)"@en,
        "Un color expresado con 6 caracteres hexadecimales (sin #)"@es ;
    rdfs:range xsd:string ;
    status:term_status "unstable"@en,
        "inestable"@es .

gtfs:route a rdf:Property ;
    rdfs:label "Route"@en,
        "ruta"@es ;
    rdfs:comment "This thing is applicable to this gtfs:Route"@en,
        "Este viaje forma parte de esta gtfs:Route"@es ;
    rdfs:domain gtfs:Trip ;
    rdfs:range gtfs:FareRule,
        gtfs:Route ;
    status:term_status "unstable"@en,
        "inestable"@es .

