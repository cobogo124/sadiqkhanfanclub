    tfl1:operatesInZone tfl1:Zone1 ;
    tfl1:servedByLine tfl1:ElizabethLineRoute .

tfl1:FreedomPassConcession a tfl1:FareConcession ;
    rdfs:label "Freedom Pass – Free Bus Travel"@en ;
    tfl1:concessionAppliesTo tfl1:Bus11,
        tfl1:Bus13,
        tfl1:Bus15,
        tfl1:Bus176,
        tfl1:Bus24,
        tfl1:Bus29,
        tfl1:Bus53,
        tfl1:Bus6,
        tfl1:Bus87,
        tfl1:Bus9,
        tfl1:Bus91 ;
    tfl1:concessionDescription "Disabled persons holding a London Freedom Pass travel free of charge on all TfL bus services at any time of day, including peak hours."@en .

