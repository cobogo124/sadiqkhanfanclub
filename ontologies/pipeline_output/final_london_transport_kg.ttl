<http://example.org/tfl> a owl:Ontology ;
    rdfs:label "TfL London Public Transport Ontology"@en ;
    dcterms:creator "Los Caballos – 5CCSAKNE CW2" ;
    dcterms:date "2025-03-01"^^xsd:date ;
    rdfs:comment """An OWL2 ontology modelling Transport for London (TfL) services\r
    covered by the Oyster card, extending the GTFS vocabulary\r
    (http://vocab.gtfs.org/terms#) and Schema.org (http://schema.org/).\r
    Developed for 5CCSAKNE Coursework 2 – team Los Caballos."""@en ;
    owl:imports schema1:,
        gtfs: ;
    owl:versionInfo "1.0.0" .

tfl1:BakerStreetStation a tfl1:UndergroundStation ;
    rdfs:label "Baker Street"@en ;
    tfl1:hasFacility tfl1:BakerStreetToilets ;
    tfl1:operatesInZone tfl1:Zone1 ;
    tfl1:servedByLine tfl1:BakerloLine,
        tfl1:CircleLine,
        tfl1:HammersmithCityLine,
        tfl1:JubileeLine,
        tfl1:MetropolitanLine ;
    schema1:name "Baker Street" .

tfl1:BermondseyStn a tfl1:UndergroundStation ;
    rdfs:label "Bermondsey"@en ;
    tfl1:hasAccessibilityFeature tfl1:Bermondsey_StepFree ;
    tfl1:hasStepFreeStreetToPlatform true ;
    tfl1:operatesInZone tfl1:Zone2 ;
    tfl1:servedByLine tfl1:JubileeLine .

tfl1:BondStreetElizabethStation a tfl1:ElizabethLineStation ;
    rdfs:label "Bond Street (Elizabeth line)"@en ;
    tfl1:hasAccessibilityFeature tfl1:BondStreet_AudioVisual ;
    tfl1:operatesInZone tfl1:Zone1 ;
    tfl1:servedByLine tfl1:ElizabethLineRoute .

tfl1:BusFlatFare a tfl1:FlatFare ;
    rdfs:label "Bus Flat Fare (Oyster/Contactless)"@en ;
    tfl1:fareAmount 1.75 ;
    tfl1:fareAppliesTo tfl1:BusRoute ;
    tfl1:farePassengerType "Adult" ;
    schema1:priceCurrency "GBP" .

tfl1:CanadaWaterStation a tfl1:InterchangeStation,
        tfl1:OvergroundStation ;
    rdfs:label "Canada Water"@en ;
    tfl1:hasAccessibilityFeature tfl1:CanadaWater_AssistedBoarding ;
    tfl1:operatesInZone tfl1:Zone2 ;
    tfl1:servedByLine tfl1:JubileeLine,
        tfl1:LondonOverground .

tfl1:ChigwellStation a tfl1:UndergroundStation ;
    rdfs:label "Chigwell"@en ;
    tfl1:hasFacility tfl1:ChigwellCarPark ;
    tfl1:operatesInZone tfl1:Zone4 ;
    tfl1:servedByLine tfl1:CentralLine .

tfl1:DLRStation a owl:Class ;
    rdfs:label "DLR Station"@en ;
    rdfs:comment "A station on the Docklands Light Railway network."@en ;
    rdfs:subClassOf tfl1:TfLStation .

tfl1:DisabledOysterCardConcession a tfl1:FareConcession ;
    rdfs:label "Disabled Persons Oyster Photocard – 50% fare reduction"@en ;
    tfl1:concessionAppliesTo tfl1:Bus11,
        tfl1:Bus13,
        tfl1:Bus15,
        tfl1:Bus176,
        tfl1:Bus24,
        tfl1:Bus29,
        tfl1:Bus53,
        tfl1:Bus6,
        tfl1:Bus87,
        tfl1:Bus9,
        tfl1:Bus91 ;
    tfl1:concessionDescription "Holders of a Disabled Persons Oyster photocard pay 50% of the standard adult Oyster/contactless fare on all TfL bus services, including during peak hours."@en .

tfl1:DistrictLine a tfl1:UndergroundLine ;
    rdfs:label "District Line"@en ;
    tfl1:isFlatFare false ;
    tfl1:isNightTube false ;
    tfl1:lineColour "00782A" ;
    tfl1:operatedBy tfl1:TransportForLondon ;
    tfl1:operatesInZone tfl1:Zone1,
        tfl1:Zone2,
        tfl1:Zone3,
        tfl1:Zone4,
        tfl1:Zone5,
        tfl1:Zone6 ;
    gtfs:longName "District Line" .

tfl1:EppingStation a tfl1:TerminalStation,
        tfl1:UndergroundStation ;
    rdfs:label "Epping"@en ;
    tfl1:hasFacility tfl1:EppingCarPark ;
    tfl1:operatesInZone tfl1:Zone6 ;
    tfl1:servedByLine tfl1:CentralLine .

