# ─── CQ20: Fare concessions for disabled passengers on buses ─────────────────

tfl:FreedomPassConcession a tfl:FareConcession ;
    rdfs:label "Freedom Pass – Free Bus Travel"@en ;
    tfl:concessionDescription "Disabled persons holding a London Freedom Pass travel free of charge on all TfL bus services at any time of day, including peak hours."@en ;
    tfl:concessionAppliesTo tfl:Bus6, tfl:Bus9, tfl:Bus11, tfl:Bus13, tfl:Bus15,
        tfl:Bus24, tfl:Bus29, tfl:Bus53, tfl:Bus87, tfl:Bus91, tfl:Bus176 .

tfl:DisabledOysterCardConcession a tfl:FareConcession ;
    rdfs:label "Disabled Persons Oyster Photocard – 50% fare reduction"@en ;
    tfl:concessionDescription "Holders of a Disabled Persons Oyster photocard pay 50% of the standard adult Oyster/contactless fare on all TfL bus services, including during peak hours."@en ;
    tfl:concessionAppliesTo tfl:Bus6, tfl:Bus9, tfl:Bus11, tfl:Bus13, tfl:Bus15,
        tfl:Bus24, tfl:Bus29, tfl:Bus53, tfl:Bus87, tfl:Bus91, tfl:Bus176 .

tfl:NationalDisabledBusPass a tfl:FareConcession ;
    rdfs:label "National Disabled Bus Pass – Free Bus Travel"@en ;
    tfl:concessionDescription "Eligible disabled passengers holding a national disabled bus pass are entitled to free travel on all TfL local bus services at all times."@en ;
    tfl:concessionAppliesTo tfl:Bus6, tfl:Bus9, tfl:Bus11, tfl:Bus13, tfl:Bus15,
        tfl:Bus24, tfl:Bus29, tfl:Bus53, tfl:Bus87, tfl:Bus91, tfl:Bus176 .
