# ─── CQ9: Bus routes at Trafalgar Square ─────────────────────────────────────

tfl:TrafalgarSquareBusTerminus a tfl:BusTerminus ;
    rdfs:label "Trafalgar Square Bus Terminus"@en ;
    schema:name "Trafalgar Square" ;
    tfl:operatesInZone tfl:Zone1 .

# (Bus routes 6,9,11,13,15,24,29,53,87,91,176 already link tfl:terminatesAt
#  tfl:TrafalgarSquareBusTerminus above)

# ─── CQ10: Night Tube lines (declared on each NightTubeLine instance above) ───
# Central, Jubilee, Northern, Piccadilly, Victoria lines have tfl:isNightTube true

# ─── CQ11: Peak-hour Oyster adult fare zones 1–3 ─────────────────────────────

tfl:PeakFare_Adult_Z1to3 a tfl:PeakFare ;
    rdfs:label "Adult Peak Oyster Fare – Zones 1 to 3"@en ;
    tfl:farePassengerType "Adult" ;
    tfl:fareAmount 3.70 ;
    schema:priceCurrency "GBP" ;
    tfl:appliesInZoneFrom tfl:Zone1 ;
    tfl:appliesInZoneTo tfl:Zone3 .

# ─── CQ12: Flat-fare transport modes ─────────────────────────────────────────

tfl:BusFlatFare a tfl:FlatFare ;
    rdfs:label "Bus Flat Fare (Oyster/Contactless)"@en ;
    tfl:farePassengerType "Adult" ;
    tfl:fareAmount 1.75 ;
    schema:priceCurrency "GBP" ;
    tfl:fareAppliesTo tfl:BusRoute .

tfl:TramFlatFare a tfl:FlatFare ;
    rdfs:label "Tram Flat Fare (Oyster/Contactless)"@en ;
    tfl:farePassengerType "Adult" ;
    tfl:fareAmount 1.75 ;
    schema:priceCurrency "GBP" ;
    tfl:fareAppliesTo tfl:TramLine .

# (tfl:BusRoute and tfl:TramLine also carry tfl:isFlatFare true on instances)

# ─── CQ13: Engineering closure (example – can be populated by pipeline) ───────

tfl:DLR_BankLewisham_Closure a tfl:EngineeringClosure ;
    rdfs:label "DLR Bank–Lewisham Planned Engineering Closure"@en ;
    tfl:closureDescription "Planned suspension of DLR services between Bank and Lewisham for track and signalling maintenance. No DLR service Bank–Stratford or Lewisham–Tower Gateway."@en ;
    tfl:closureStartDate "2025-04-05T00:30:00"^^xsd:dateTime ;
    tfl:closureEndDate   "2025-04-06T23:59:00"^^xsd:dateTime ;
    tfl:hasAlternativeService
        tfl:DLR_Alt_Jubilee,
        tfl:DLR_Alt_SouthEastern .

# ─── CQ14: Alternative services when DLR is suspended ────────────────────────

tfl:DLR_Alt_Jubilee a tfl:AlternativeService ;
    rdfs:label "Alternative: Jubilee Line via Canada Water"@en ;
    rdfs:comment "Passengers may use the Jubilee Line between Stratford and Canada Water, then change for services towards Lewisham."@en ;
    tfl:alternativeUsing tfl:JubileeLine .

tfl:DLR_Alt_SouthEastern a tfl:AlternativeService ;
    rdfs:label "Alternative: Southeastern Rail (London Bridge – Lewisham)"@en ;
    rdfs:comment "Southeastern National Rail services from London Bridge to Lewisham operate as an alternative to the DLR route."@en .

# ─── CQ15: Journey Brixton → Canary Wharf ────────────────────────────────────

tfl:Journey_BrixtonToCanaryWharf a tfl:Journey ;
    rdfs:label "Brixton to Canary Wharf"@en ;
    tfl:journeyOrigin      tfl:BrixtonStation ;
    tfl:journeyDestination tfl:CanaryWharfStation ;
    tfl:estimatedJourneyMinutes 32 ;
    tfl:numberOfLegs 2 ;
    tfl:hasJourneyLeg
        tfl:Leg1_Victoria_BrixtonToGreenPark,
        tfl:Leg2_Jubilee_GreenParkToCanaryWharf .

tfl:GreenParkStation a tfl:InterchangeStation ;
    rdfs:label "Green Park"@en ;
    schema:name "Green Park" ;
    tfl:operatesInZone tfl:Zone1 ;
    tfl:servedByLine tfl:VictoriaLine, tfl:JubileeLine, tfl:PiccadillyLine .

tfl:Leg1_Victoria_BrixtonToGreenPark a tfl:JourneyLeg ;
    rdfs:label "Leg 1 – Victoria Line: Brixton → Green Park"@en ;
    tfl:legSequence 1 ;
    tfl:legUsesLine  tfl:VictoriaLine ;
    tfl:legBoardsAt  tfl:BrixtonStation ;
    tfl:legAlightsAt tfl:GreenParkStation .

tfl:Leg2_Jubilee_GreenParkToCanaryWharf a tfl:JourneyLeg ;
    rdfs:label "Leg 2 – Jubilee Line: Green Park → Canary Wharf"@en ;
    tfl:legSequence 2 ;
    tfl:legUsesLine  tfl:JubileeLine ;
    tfl:legBoardsAt  tfl:GreenParkStation ;
    tfl:legAlightsAt tfl:CanaryWharfStation .

