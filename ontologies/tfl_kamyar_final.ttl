    tfl:operatesInZone tfl:Zone1 ;
    tfl:servedByLine
        tfl:CircleLine,
        tfl:HammersmithCityLine,
        tfl:MetropolitanLine,
        tfl:NorthernLine,
        tfl:PiccadillyLine,
        tfl:VictoriaLine ;
    tfl:hasAccessibilityFeature tfl:KingsCross_StepFree ;
    tfl:hasStepFreeStreetToPlatform true .

tfl:KingsCross_StepFree a tfl:StepFreeAccess ;
    rdfs:label "Step-Free Access – King's Cross St Pancras"@en .

