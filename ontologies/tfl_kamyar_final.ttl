@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix gtfs:   <http://vocab.gtfs.org/terms#> .
@prefix tfl:    <http://example.org/tfl#> .

# =============================================================================
# ONTOLOGY DECLARATION
# =============================================================================

<http://example.org/tfl> a owl:Ontology ;
    rdfs:label "TfL London Public Transport Ontology"@en ;
    rdfs:comment """An OWL2 ontology modelling Transport for London (TfL) services
    covered by the Oyster card, extending the GTFS vocabulary
    (http://vocab.gtfs.org/terms#) and Schema.org (http://schema.org/).
    Developed for 5CCSAKNE Coursework 2 – team Los Caballos."""@en ;
    owl:imports <http://vocab.gtfs.org/terms#> ;
    owl:imports <http://schema.org/> ;
    dct:creator "Los Caballos – 5CCSAKNE CW2" ;
    dct:date "2025-03-01"^^xsd:date ;
    owl:versionInfo "1.0.0" .

# =============================================================================
# T B O X – C L A S S E S
# =============================================================================

# ─── Transport Line Classes (subclasses of gtfs:Route) ───────────────────────

tfl:TfLLine a owl:Class ;
    rdfs:subClassOf gtfs:Route ;
    rdfs:label "TfL Line"@en ;
    rdfs:comment "A named service line operated by TfL or a contracted operator under the TfL network umbrella, accepting Oyster card or contactless payment."@en .

tfl:UndergroundLine a owl:Class ;
    rdfs:subClassOf tfl:TfLLine ;
    rdfs:label "London Underground Line"@en ;
    rdfs:comment "A line on the London Underground (Tube) network."@en .

tfl:NightTubeLine a owl:Class ;
    rdfs:subClassOf tfl:UndergroundLine ;
    rdfs:label "Night Tube Line"@en ;
    rdfs:comment "A London Underground line that operates a 24-hour service on Friday and Saturday nights under the Night Tube programme."@en .

tfl:OvergroundLine a owl:Class ;
    rdfs:subClassOf tfl:TfLLine ;
    rdfs:label "London Overground Line"@en ;
    rdfs:comment "A line on the London Overground network, operated under TfL franchise."@en .

tfl:ElizabethLineService a owl:Class ;
    rdfs:subClassOf tfl:TfLLine ;
    rdfs:label "Elizabeth Line Service"@en ;
    rdfs:comment "The Elizabeth Line (Crossrail) operated under a TfL concession agreement."@en .

tfl:DLRLine a owl:Class ;
    rdfs:subClassOf tfl:TfLLine ;
    rdfs:label "Docklands Light Railway Line"@en ;
    rdfs:comment "A line on the automated Docklands Light Railway (DLR) network."@en .

tfl:TramLine a owl:Class ;
    rdfs:subClassOf tfl:TfLLine ;
    rdfs:label "TfL Tram Line"@en ;
    rdfs:comment "A line on the London Trams (Tramlink) network operating in south London."@en .

tfl:BusRoute a owl:Class ;
    rdfs:subClassOf tfl:TfLLine ;
    rdfs:label "TfL Bus Route"@en ;
    rdfs:comment "A numbered or lettered bus route contracted to operate within the TfL network."@en .

tfl:NightBusRoute a owl:Class ;
    rdfs:subClassOf tfl:BusRoute ;
    rdfs:label "Night Bus Route"@en ;
    rdfs:comment "A TfL bus route operating overnight, identified by an N-prefix route number (e.g. N29, N73)."@en .

# ─── Station / Stop Classes (subclasses of gtfs:Station) ────────────────────

tfl:TfLStation a owl:Class ;
    rdfs:subClassOf gtfs:Station ;
    rdfs:label "TfL Station"@en ;
    rdfs:comment "A station or stop within the TfL network at which Oyster card or contactless payment is accepted."@en .

tfl:UndergroundStation a owl:Class ;
    rdfs:subClassOf tfl:TfLStation ;
    rdfs:label "London Underground Station"@en ;
    rdfs:comment "A station on the London Underground network."@en .

tfl:InterchangeStation a owl:Class ;
    rdfs:subClassOf tfl:TfLStation ;
    rdfs:label "Interchange Station"@en ;
    rdfs:comment "A station where passengers may transfer between two or more distinct TfL lines or transport modes."@en .

tfl:TerminalStation a owl:Class ;
    rdfs:subClassOf tfl:TfLStation ;
    rdfs:label "Terminal Station"@en ;
    rdfs:comment "The first or last stop on a TfL line, at which all services originate or terminate."@en .

tfl:BusTerminus a owl:Class ;
    rdfs:subClassOf tfl:TfLStation ;
    rdfs:label "Bus Terminus"@en ;
    rdfs:comment "A stop or stand at which one or more bus routes begin or end their journeys."@en .

tfl:ElizabethLineStation a owl:Class ;
    rdfs:subClassOf tfl:TfLStation ;
    rdfs:label "Elizabeth Line Station"@en ;
    rdfs:comment "A station served by Elizabeth Line services."@en .

tfl:OvergroundStation a owl:Class ;
    rdfs:subClassOf tfl:TfLStation ;
    rdfs:label "London Overground Station"@en ;
    rdfs:comment "A station on the London Overground network."@en .

tfl:DLRStation a owl:Class ;
    rdfs:subClassOf tfl:TfLStation ;
    rdfs:label "DLR Station"@en ;
    rdfs:comment "A station on the Docklands Light Railway network."@en .

# ─── Fare and Payment Classes (subclasses of schema:PriceSpecification) ──────

tfl:OysterFare a owl:Class ;
    rdfs:subClassOf schema:PriceSpecification ;
    rdfs:label "Oyster Fare"@en ;
    rdfs:comment "A fare charged when a TfL journey is paid for by Oyster card or contactless bank card."@en .

tfl:PeakFare a owl:Class ;
    rdfs:subClassOf tfl:OysterFare ;
    rdfs:label "Peak Hour Oyster Fare"@en ;
    rdfs:comment "An Oyster fare applicable during TfL-defined peak hours (Mon–Fri 06:30–09:30 and 16:00–19:00)."@en .

tfl:OffPeakFare a owl:Class ;
    rdfs:subClassOf tfl:OysterFare ;
    rdfs:label "Off-Peak Oyster Fare"@en ;
    rdfs:comment "An Oyster fare applicable outside TfL-defined peak hours."@en .

tfl:FlatFare a owl:Class ;
    rdfs:subClassOf tfl:OysterFare ;
    rdfs:label "Flat Fare"@en ;
    rdfs:comment "A single fixed fare charged regardless of the distance or number of fare zones travelled (e.g. buses, trams)."@en .

tfl:OysterFareZone a owl:Class ;
    rdfs:subClassOf gtfs:Zone ;
    rdfs:label "Oyster Fare Zone"@en ;
    rdfs:comment "One of the concentric geographic fare zones (1–6 and outer) used by TfL to calculate distance-based Oyster fares."@en .

tfl:FareConcession a owl:Class ;
    rdfs:label "Fare Concession"@en ;
    rdfs:comment "A discounted or free travel entitlement available to qualifying passengers (e.g. Freedom Pass holders, disabled persons)."@en .

# ─── Accessibility Classes ───────────────────────────────────────────────────

tfl:AccessibilityFeature a owl:Class ;
    rdfs:label "Accessibility Feature"@en ;
    rdfs:comment "A facility or feature at a TfL station that improves access for passengers with reduced mobility or sensory impairment."@en .

tfl:StepFreeAccess a owl:Class ;
    rdfs:subClassOf tfl:AccessibilityFeature ;
    rdfs:label "Step-Free Access"@en ;
    rdfs:comment "A continuous route from street level to the platform with no steps, provided via lifts or level-access ramps."@en .

tfl:AudioVisualAid a owl:Class ;
    rdfs:subClassOf tfl:AccessibilityFeature ;
    rdfs:label "Audio-Visual Aid"@en ;
    rdfs:comment "Electronic or physical aids (hearing loops, visual information displays, public address systems) assisting passengers with sensory impairments."@en .

tfl:AssistedBoardingService a owl:Class ;
    rdfs:subClassOf tfl:AccessibilityFeature ;
    rdfs:label "Assisted Boarding Service"@en ;
    rdfs:comment "A staff-provided service that assists passengers with disabilities to board or alight from trains safely."@en .

# ─── Station Facility Classes ────────────────────────────────────────────────

tfl:StationFacility a owl:Class ;
    rdfs:label "Station Facility"@en ;
    rdfs:comment "An amenity or piece of infrastructure available at a TfL station for passenger use."@en .

tfl:PublicToilet a owl:Class ;
    rdfs:subClassOf tfl:StationFacility ;
    rdfs:label "Public Toilet"@en ;
    rdfs:comment "A publicly accessible restroom / lavatory facility located at or within a TfL station."@en .

tfl:CarPark a owl:Class ;
    rdfs:subClassOf tfl:StationFacility ;
    rdfs:label "Station Car Park"@en ;
    rdfs:comment "A car parking facility at a TfL station, intended for use by passengers travelling onward by public transport (park-and-ride)."@en .

# ─── Service Disruption Classes ──────────────────────────────────────────────

tfl:ServiceDisruption a owl:Class ;
    rdfs:label "Service Disruption"@en ;
    rdfs:comment "Any planned or unplanned event that reduces or suspends normal TfL services on a line or at a station."@en .

tfl:EngineeringClosure a owl:Class ;
    rdfs:subClassOf tfl:ServiceDisruption ;
    rdfs:label "Engineering Closure"@en ;
    rdfs:comment "A planned suspension of TfL services to allow infrastructure maintenance or engineering work."@en .

tfl:AlternativeService a owl:Class ;
    rdfs:label "Alternative Service"@en ;
    rdfs:comment "A replacement or diversionary transport service recommended to passengers during a TfL service disruption."@en .

# ─── Journey Planning Classes ────────────────────────────────────────────────

tfl:Journey a owl:Class ;
    rdfs:subClassOf schema:Trip ;
    rdfs:label "TfL Journey"@en ;
    rdfs:comment "A planned or completed passenger journey from an origin station to a destination station across the TfL network."@en .

tfl:JourneyLeg a owl:Class ;
    rdfs:label "Journey Leg"@en ;
    rdfs:comment "A single continuous segment of a TfL journey on one line or mode, without interchange."@en .

# ─── Operator Class (subclass of gtfs:Agency) ────────────────────────────────

tfl:TfLOperator a owl:Class ;
    rdfs:subClassOf gtfs:Agency ;
    rdfs:label "TfL Operator"@en ;
    rdfs:comment "An organisation operating TfL services under a franchise, concession or direct management arrangement."@en .

# =============================================================================
# T B O X – O B J E C T   P R O P E R T I E S
# =============================================================================

tfl:servedByLine a owl:ObjectProperty ;
    rdfs:subPropertyOf gtfs:route ;
    rdfs:label "served by line"@en ;
    rdfs:comment "Links a TfL station to one of the lines that calls at it."@en ;
    rdfs:domain tfl:TfLStation ;
    rdfs:range  tfl:TfLLine .

tfl:hasTerminalStation a owl:ObjectProperty ;
    rdfs:label "has terminal station"@en ;
    rdfs:comment "Links a TfL line to one of its terminal (end-of-line) stations."@en ;
    rdfs:domain tfl:TfLLine ;
    rdfs:range  tfl:TerminalStation .

tfl:operatesInZone a owl:ObjectProperty ;
    rdfs:subPropertyOf gtfs:zone ;
    rdfs:label "operates in zone"@en ;
    rdfs:comment "Links a TfL line or station to an Oyster fare zone it operates within."@en ;
    rdfs:range  tfl:OysterFareZone .

tfl:hasAccessibilityFeature a owl:ObjectProperty ;
    rdfs:label "has accessibility feature"@en ;
    rdfs:comment "Links a TfL station to an accessibility feature available at that station."@en ;
    rdfs:domain tfl:TfLStation ;
    rdfs:range  tfl:AccessibilityFeature .

tfl:hasFacility a owl:ObjectProperty ;
    rdfs:label "has facility"@en ;
    rdfs:comment "Links a TfL station to a physical passenger facility available at that station."@en ;
    rdfs:domain tfl:TfLStation ;
    rdfs:range  tfl:StationFacility .

tfl:operatedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:provider ;
    rdfs:label "operated by"@en ;
    rdfs:comment "Links a TfL line to the organisation that operates it under franchise or concession."@en ;
    rdfs:domain tfl:TfLLine ;
    rdfs:range  tfl:TfLOperator .

tfl:terminatesAt a owl:ObjectProperty ;
    rdfs:label "terminates at"@en ;
    rdfs:comment "Links a bus route to the terminus stop at which it begins or ends."@en ;
    rdfs:domain tfl:BusRoute ;
    rdfs:range  tfl:BusTerminus .

tfl:hasDisruption a owl:ObjectProperty ;
    rdfs:label "has disruption"@en ;
    rdfs:comment "Links a TfL line to a current or upcoming service disruption affecting it."@en ;
    rdfs:domain tfl:TfLLine ;
    rdfs:range  tfl:ServiceDisruption .

tfl:hasAlternativeService a owl:ObjectProperty ;
    rdfs:label "has alternative service"@en ;
    rdfs:comment "Links a service disruption to a recommended alternative service for affected passengers."@en ;
    rdfs:domain tfl:ServiceDisruption ;
    rdfs:range  tfl:AlternativeService .

tfl:alternativeUsing a owl:ObjectProperty ;
    rdfs:label "alternative using"@en ;
    rdfs:comment "Links an alternative service recommendation to the TfL line that provides the replacement."@en ;
    rdfs:domain tfl:AlternativeService ;
    rdfs:range  tfl:TfLLine .

tfl:hasJourneyLeg a owl:ObjectProperty ;
    rdfs:label "has journey leg"@en ;
    rdfs:comment "Links a journey to one of its individual legs."@en ;
    rdfs:domain tfl:Journey ;
    rdfs:range  tfl:JourneyLeg .

tfl:legUsesLine a owl:ObjectProperty ;
    rdfs:label "leg uses line"@en ;
    rdfs:comment "Links a journey leg to the TfL line used during that leg."@en ;
    rdfs:domain tfl:JourneyLeg ;
    rdfs:range  tfl:TfLLine .

tfl:journeyOrigin a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:departureStation ;
    rdfs:label "journey origin"@en ;
    rdfs:comment "The station from which a TfL journey departs."@en ;
    rdfs:domain tfl:Journey ;
    rdfs:range  tfl:TfLStation .

tfl:journeyDestination a owl:ObjectProperty ;
    rdfs:subPropertyOf schema:arrivalStation ;
    rdfs:label "journey destination"@en ;
    rdfs:comment "The station at which a TfL journey arrives."@en ;
    rdfs:domain tfl:Journey ;
    rdfs:range  tfl:TfLStation .

tfl:legBoardsAt a owl:ObjectProperty ;
    rdfs:label "leg boards at"@en ;
    rdfs:comment "The station at which a passenger boards for this journey leg."@en ;
    rdfs:domain tfl:JourneyLeg ;
    rdfs:range  tfl:TfLStation .

tfl:legAlightsAt a owl:ObjectProperty ;
    rdfs:label "leg alights at"@en ;
    rdfs:comment "The station at which a passenger alights at the end of this journey leg."@en ;
    rdfs:domain tfl:JourneyLeg ;
    rdfs:range  tfl:TfLStation .

tfl:appliesInZoneFrom a owl:ObjectProperty ;
    rdfs:label "applies in zone from"@en ;
    rdfs:comment "The lowest-numbered Oyster fare zone included in the range covered by this fare."@en ;
    rdfs:domain tfl:OysterFare ;
    rdfs:range  tfl:OysterFareZone .

tfl:appliesInZoneTo a owl:ObjectProperty ;
    rdfs:label "applies in zone to"@en ;
    rdfs:comment "The highest-numbered Oyster fare zone included in the range covered by this fare."@en ;
    rdfs:domain tfl:OysterFare ;
    rdfs:range  tfl:OysterFareZone .

tfl:fareAppliesTo a owl:ObjectProperty ;
    rdfs:label "fare applies to"@en ;
    rdfs:comment "Links an Oyster fare to the transport mode class it applies to."@en ;
    rdfs:domain tfl:OysterFare .

tfl:hasConcession a owl:ObjectProperty ;
    rdfs:label "has concession"@en ;
    rdfs:comment "Links a transport mode (class) or line to a fare concession available on it."@en .

tfl:concessionAppliesTo a owl:ObjectProperty ;
    rdfs:label "concession applies to"@en ;
    rdfs:comment "Links a fare concession to the TfL line or mode on which it is valid."@en ;
    rdfs:domain tfl:FareConcession ;
    rdfs:range  tfl:TfLLine .

# =============================================================================
# T B O X – D A T A T Y P E   P R O P E R T I E S
# =============================================================================

tfl:fareAmount a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:price ;
    rdfs:label "fare amount (GBP)"@en ;
    rdfs:comment "The monetary value of an Oyster/contactless fare in pounds sterling."@en ;
    rdfs:domain tfl:OysterFare ;
    rdfs:range  xsd:decimal .

tfl:farePassengerType a owl:DatatypeProperty ;
    rdfs:label "fare passenger type"@en ;
    rdfs:comment "The passenger category to which an Oyster fare applies (e.g. 'Adult', 'Child', 'Railcard holder')."@en ;
    rdfs:domain tfl:OysterFare ;
    rdfs:range  xsd:string .

tfl:isNightTube a owl:DatatypeProperty ;
    rdfs:label "is Night Tube"@en ;
    rdfs:comment "True if this Underground line operates a 24-hour Night Tube service on Friday and Saturday nights."@en ;
    rdfs:domain tfl:UndergroundLine ;
    rdfs:range  xsd:boolean .

tfl:isFlatFare a owl:DatatypeProperty ;
    rdfs:label "is flat fare"@en ;
    rdfs:comment "True if this transport mode charges a single flat fare regardless of distance or zones travelled."@en ;
    rdfs:domain tfl:TfLLine ;
    rdfs:range  xsd:boolean .

tfl:routeNumber a owl:DatatypeProperty ;
    rdfs:subPropertyOf gtfs:shortName ;
    rdfs:label "route number"@en ;
    rdfs:comment "The identifying number or alphanumeric code of a bus route (e.g. '24', 'N29')."@en ;
    rdfs:domain tfl:BusRoute ;
    rdfs:range  xsd:string .

tfl:lineColour a owl:DatatypeProperty ;
    rdfs:subPropertyOf gtfs:color ;
    rdfs:label "line colour (hex)"@en ;
    rdfs:comment "The official TfL six-character hexadecimal colour code used to identify this line on maps and signage."@en ;
    rdfs:domain tfl:TfLLine ;
    rdfs:range  xsd:string .

tfl:nightTubeOperatingDays a owl:DatatypeProperty ;
    rdfs:label "Night Tube operating days"@en ;
    rdfs:comment "A description of the days on which the Night Tube service operates (typically 'Friday night and Saturday night')."@en ;
    rdfs:domain tfl:NightTubeLine ;
    rdfs:range  xsd:string .

tfl:hasStepFreeStreetToPlatform a owl:DatatypeProperty ;
    rdfs:label "has step-free street to platform"@en ;
    rdfs:comment "True if the station provides a fully step-free route from street level to the platform."@en ;
    rdfs:domain tfl:TfLStation ;
    rdfs:range  xsd:boolean .

tfl:zoneNumber a owl:DatatypeProperty ;
    rdfs:label "zone number"@en ;
    rdfs:comment "The integer identifier (1–6) of an Oyster fare zone."@en ;
    rdfs:domain tfl:OysterFareZone ;
    rdfs:range  xsd:positiveInteger .

tfl:estimatedJourneyMinutes a owl:DatatypeProperty ;
    rdfs:label "estimated journey minutes"@en ;
    rdfs:comment "The estimated total travel time in minutes for a TfL journey under normal service conditions."@en ;
    rdfs:domain tfl:Journey ;
    rdfs:range  xsd:nonNegativeInteger .

tfl:numberOfLegs a owl:DatatypeProperty ;
    rdfs:label "number of legs"@en ;
    rdfs:comment "The total number of legs (interchange-separated segments) in a TfL journey."@en ;
    rdfs:domain tfl:Journey ;
    rdfs:range  xsd:nonNegativeInteger .

tfl:legSequence a owl:DatatypeProperty ;
    rdfs:label "leg sequence"@en ;
    rdfs:comment "The ordinal position of this leg within its parent journey (1 = first leg)."@en ;
    rdfs:domain tfl:JourneyLeg ;
    rdfs:range  xsd:positiveInteger .

tfl:closureStartDate a owl:DatatypeProperty ;
    rdfs:label "closure start date"@en ;
    rdfs:comment "The date and time from which a planned engineering closure takes effect."@en ;
    rdfs:domain tfl:EngineeringClosure ;
    rdfs:range  xsd:dateTime .

tfl:closureEndDate a owl:DatatypeProperty ;
    rdfs:label "closure end date"@en ;
    rdfs:comment "The date and time at which a planned engineering closure ends and normal service resumes."@en ;
    rdfs:domain tfl:EngineeringClosure ;
    rdfs:range  xsd:dateTime .

tfl:closureDescription a owl:DatatypeProperty ;
    rdfs:label "closure description"@en ;
    rdfs:comment "A human-readable description of an engineering closure, including affected sections and reason."@en ;
    rdfs:domain tfl:EngineeringClosure ;
    rdfs:range  xsd:string .

tfl:concessionDescription a owl:DatatypeProperty ;
    rdfs:label "concession description"@en ;
    rdfs:comment "A textual description of the eligibility criteria and travel benefits of a fare concession."@en ;
    rdfs:domain tfl:FareConcession ;
    rdfs:range  xsd:string .

# =============================================================================
# A B O X – I N S T A N C E S
# =============================================================================

# ─── Fare Zones ──────────────────────────────────────────────────────────────

tfl:Zone1 a tfl:OysterFareZone ;
    rdfs:label "Zone 1"@en ; tfl:zoneNumber 1 .

tfl:Zone2 a tfl:OysterFareZone ;
    rdfs:label "Zone 2"@en ; tfl:zoneNumber 2 .

tfl:Zone3 a tfl:OysterFareZone ;
    rdfs:label "Zone 3"@en ; tfl:zoneNumber 3 .

tfl:Zone4 a tfl:OysterFareZone ;
    rdfs:label "Zone 4"@en ; tfl:zoneNumber 4 .

tfl:Zone5 a tfl:OysterFareZone ;
    rdfs:label "Zone 5"@en ; tfl:zoneNumber 5 .

tfl:Zone6 a tfl:OysterFareZone ;
    rdfs:label "Zone 6"@en ; tfl:zoneNumber 6 .

# ─── Operators ───────────────────────────────────────────────────────────────

tfl:TransportForLondon a tfl:TfLOperator ;
    rdfs:label "Transport for London"@en ;
    schema:name "Transport for London" ;
    schema:url <https://tfl.gov.uk> .

tfl:MTR_Elizabeth a tfl:TfLOperator ;
    rdfs:label "MTR Elizabeth line"@en ;
    schema:name "MTR Elizabeth line" .

tfl:ArrivaRailLondon a tfl:TfLOperator ;
    rdfs:label "Arriva Rail London"@en ;
    schema:name "Arriva Rail London" ;
    rdfs:comment "Contracted operator of London Overground services under TfL franchise."@en .

tfl:SercoAbellio a tfl:TfLOperator ;
    rdfs:label "Serco Docklands"@en ;
    schema:name "Serco Docklands" ;
    rdfs:comment "Contracted operator of the Docklands Light Railway under TfL franchise."@en .

# ─── Underground Lines ───────────────────────────────────────────────────────

tfl:BakerloLine a tfl:UndergroundLine ;
    rdfs:label "Bakerloo Line"@en ;
    gtfs:longName "Bakerloo Line" ;
    tfl:lineColour "B36305" ;
    tfl:operatedBy tfl:TransportForLondon ;
    tfl:operatesInZone tfl:Zone1, tfl:Zone2, tfl:Zone3, tfl:Zone4, tfl:Zone5 ;
    tfl:isNightTube false ;
    tfl:isFlatFare false .

tfl:CentralLine a tfl:UndergroundLine ;
    rdfs:label "Central Line"@en ;
    gtfs:longName "Central Line" ;
    tfl:lineColour "DC241F" ;
    tfl:operatedBy tfl:TransportForLondon ;
    tfl:operatesInZone tfl:Zone1, tfl:Zone2, tfl:Zone3, tfl:Zone4, tfl:Zone5, tfl:Zone6 ;
    tfl:isNightTube true ;
    tfl:nightTubeOperatingDays "Friday night and Saturday night"@en ;
    tfl:isFlatFare false .

tfl:CircleLine a tfl:UndergroundLine ;
    rdfs:label "Circle Line"@en ;
    gtfs:longName "Circle Line" ;
    tfl:lineColour "FFD329" ;
    tfl:operatedBy tfl:TransportForLondon ;
    tfl:operatesInZone tfl:Zone1 ;
    tfl:isNightTube false ;
    tfl:isFlatFare false .

tfl:DistrictLine a tfl:UndergroundLine ;
    rdfs:label "District Line"@en ;
    gtfs:longName "District Line" ;
    tfl:lineColour "00782A" ;
    tfl:operatedBy tfl:TransportForLondon ;
    tfl:operatesInZone tfl:Zone1, tfl:Zone2, tfl:Zone3, tfl:Zone4, tfl:Zone5, tfl:Zone6 ;
    tfl:isNightTube false ;
    tfl:isFlatFare false .

tfl:HammersmithCityLine a tfl:UndergroundLine ;
    rdfs:label "Hammersmith & City Line"@en ;
    gtfs:longName "Hammersmith and City Line" ;
    tfl:lineColour "F3A9BB" ;
    tfl:operatedBy tfl:TransportForLondon ;
    tfl:operatesInZone tfl:Zone1, tfl:Zone2, tfl:Zone3, tfl:Zone4 ;
    tfl:isNightTube false ;
    tfl:isFlatFare false .

tfl:JubileeLine a tfl:NightTubeLine ;
    rdfs:label "Jubilee Line"@en ;
    gtfs:longName "Jubilee Line" ;
    tfl:lineColour "A0A5A9" ;
    tfl:operatedBy tfl:TransportForLondon ;
    tfl:operatesInZone tfl:Zone1, tfl:Zone2, tfl:Zone3, tfl:Zone4 ;
    tfl:isNightTube true ;
    tfl:nightTubeOperatingDays "Friday night and Saturday night"@en ;
    tfl:isFlatFare false .

tfl:MetropolitanLine a tfl:UndergroundLine ;
