:stop_940GZZLUWLO a :InterchangeStation ;
    :hasAvailableMode :bus_mode,
        :underground_mode ;
    :hasCarParking false ;
    :hasCoordinates :geo_940GZZLUWLO ;
    :hasPublicToilets false ;
    :hasWifi true ;
    :inFareZone :zone_1 ;
    :isServedBy :line_bakerloo,
        :line_jubilee,
        :line_northern,
        :line_waterloo_city ;
    :isStepFree true ;
    :naptanId "940GZZLUWLO" ;
    :stepFreeAccessNote "Waterloo & City and DLR lines. Northern line A. DLR B. Lifts to both the Northern line and DLR platforms are in the ticket hall on the corner of Cannon Street/ Nicholas Lane. A further lift to the DLR is located on King William Street and is only available on request - press button to alert staff. Lifts to the Waterloo & City line r are available Mondays - Fridays, via the entrance on Walbrook. Step-free exit at Waterloo is via the National Rail lift (usually available Monday to Saturday 0430 - 0105, Sunday 0530 - 0105). Please check before you travel. Step-free interchange between the Waterloo & City line and the Northern line and DLR requires a 290m journey via street and lifts." ;
    :stopName "Waterloo" ;
    dcterms:source "https://api.tfl.gov.uk/StopPoint/940GZZLUWLO" .

